<Window x:Class="Dr_Connectify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dr.CONNECTIFY" Height="600" Width="430" ResizeMode="CanMinimize" Icon="Images/icon_32.png" Loaded="Window_Loaded" PreviewKeyUp="WindowKeyControll_KeyUp">
    <Window.Resources>
        <ControlTemplate x:Name="RoundButtonTemplate" x:Key="roundButtonTemplate" TargetType="{x:Type Button}">
            <Grid MouseEnter="RoundButton_MouseOver" MouseLeave="RoundButton_MouseLeave" MouseLeftButtonDown="RoundButton_MouseDown" MouseLeftButtonUp="RoundButton_MouseUp">
                <Ellipse Width="60" Height="60" Fill="{x:Null}" Stroke="WhiteSmoke" StrokeThickness="5"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8"/>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop x:Name="background_color" Offset="0"/>
            <GradientStop Color="White" Offset="0.213"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Image x:Name="image" Source="87.JPG" Opacity="0.25" Stretch="UniformToFill"/>
        <Rectangle x:Name="color" HorizontalAlignment="Left" Margin="0,0,0,0" Width="0" Height="0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF037F01" Offset="0"/>
                    <GradientStop Color="#FF106A0E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Stroke>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFB40100" Offset="1"/>
                    <GradientStop Color="#FFDC0201"/>
                </LinearGradientBrush>
            </Rectangle.Stroke>
        </Rectangle>
        <Grid x:Name="mother" Margin="0,0,0,0">
            <Grid Margin="0,0,-425,0" HorizontalAlignment="Left" Width="425">
                <TextBlock HorizontalAlignment="Left" Margin="10,171,0,0" TextWrapping="Wrap" Text="Network SSID:" VerticalAlignment="Top" FontSize="18"/>
                <TextBox x:Name="name" Margin="146,170,40,0" TextWrapping="Wrap" Text="Dr.Mohammad" VerticalAlignment="Top" FontSize="18" Background="{x:Null}" MaxLength="32" MaxLines="1" AutoWordSelection="True" BorderBrush="#FF289C16" TabIndex="0"/>
                <TextBlock HorizontalAlignment="Left" Margin="10,234,0,0" TextWrapping="Wrap" Text="Key:" VerticalAlignment="Top" FontSize="18"/>
                <PasswordBox x:Name="password" Margin="146,233,92,0" VerticalAlignment="Top" FontSize="22" Password="Dr.Mohammad" Background="{x:Null}" MaxLength="63" PasswordChar="&#xF053;" FontFamily="Wingdings" BorderBrush="#FFC500FF" TabIndex="1"/>
                <TextBox x:Name="password_shadow" Margin="60,219,56,0" VerticalAlignment="Top" FontSize="18" Text="Dr.Mohammad" Background="{x:Null}" Visibility="Collapsed" AutoWordSelection="True" MaxLines="1" MaxLength="63" BorderBrush="#FFC500FF"/>
                <Button x:Name="show_password" ToolTip="Show password" HorizontalAlignment="Right" Margin="0,233,66,0" VerticalAlignment="Top" Background="{x:Null}" Click="ShowHide_Click" BorderBrush="#FFC500FF" TabIndex="5">
                    <Button.Content>
                        <Image Source="Images/eye.png" Stretch="None"/>
                    </Button.Content>
                </Button>
                <Grid x:Name="start_stop_grid" Margin="10,0,10,40" VerticalAlignment="Bottom" Height="50">
                    <Button x:Name="go" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="22" Click="Add_Click" Background="{x:Null}" Foreground="RoyalBlue" Margin="80,5,0,0" Width="190" BorderBrush="RoyalBlue" TabIndex="3">
                        <Button.Content>
                            <Grid Width="178" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="177"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image HorizontalAlignment="Left" Source="Images/windows_shell.png" Stretch="None" Grid.Column="1"/>
                                    <TextBlock Text="Go ahead" Margin="50,4,0,0" Height="27" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <Button x:Name="stop" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="22" Click="Remove_Click" Background="{x:Null}" Foreground="Red" Margin="600,5,0,0" Width="190" BorderBrush="Red" TabIndex="4">
                        <Button.Content>
                            <Grid Width="178" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="177"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image HorizontalAlignment="Left" Source="Images/windows_shell.png" Stretch="None" Grid.Column="1"/>
                                    <TextBlock Text="Stop network" Margin="39,4,0,0" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>
                <Button x:Name="goto_clients" ToolTip="Go to clients tap" HorizontalAlignment="Right" Height="52" Margin="0,0,20,20" VerticalAlignment="Bottom" Width="52" Background="{x:Null}" Click="ClientTap_Click" BorderBrush="{x:Null}" Visibility="Hidden">
                    <Button.Content>
                        <Image Source="Images/arrow-right.png" Width="48" Height="48"/>
                    </Button.Content>
                </Button>
                <Button x:Name="button" Content="Check state" HorizontalAlignment="Right" Margin="0,142,10,0" VerticalAlignment="Top" Width="75" Background="{x:Null}" BorderBrush="#FF158580" Foreground="#FF158580" Click="Check_Click" TabIndex="6"/>
                <Button x:Name="button1" ToolTip="Generate random password" HorizontalAlignment="Right" Margin="0,233,40,0" VerticalAlignment="Top" Width="27" BorderBrush="#FFC500FF" Background="{x:Null}" Foreground="#FFC500FF" Height="26" Click="GeneratePassword_Click" TabIndex="7">
                    <Button.Content>
                        <Image Source="Images/password.png" Stretch="UniformToFill" Width="22" Height="22"/>
                    </Button.Content>
                </Button>
            </Grid>
            <Grid Margin="425,0,-336,0" Width="380" HorizontalAlignment="Left">
                <TextBlock x:Name="state2" HorizontalAlignment="Right" Margin="0,60,20,0" TextWrapping="Wrap" Text="Deactive" VerticalAlignment="Top" FontSize="18" Foreground="Red"/>
                <TextBlock HorizontalAlignment="Left" Margin="20,80,0,0" TextWrapping="Wrap" Text="Clients:" VerticalAlignment="Top" FontSize="20"/>
                <ListView x:Name="client_list" FontSize="18" Margin="60,112,30,41" Background="{x:Null}"/>
                <TextBlock x:Name="total_clients" Margin="60,0,0,14" TextWrapping="Wrap" Text="Total Clients = 0" VerticalAlignment="Bottom" FontSize="16" HorizontalAlignment="Left"/>
                <CheckBox x:Name="checkBox" Content="Auto Refresh" HorizontalAlignment="Right" Margin="0,89,30,0" VerticalAlignment="Top" FontSize="14" Checked="RefreshClientsList_Checked" IsChecked="True" Unchecked="RefreshClientsList_Unchecked" TabIndex="12"/>
            </Grid>
        </Grid>
        <Rectangle HorizontalAlignment="Left" Height="27" Margin="0,96,0,0" VerticalAlignment="Top" Width="424" Opacity="0.5">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF8F8F8F"/>
                    <GradientStop Color="#FF191919" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock x:Name="state" Margin="320,70,5,0" TextTrimming="CharacterEllipsis" FontSize="16" Text="Deactivated" VerticalAlignment="Top" Foreground="Tomato" TextAlignment="Center"/>
        <TextBlock HorizontalAlignment="Left" Margin="28,8,0,0" TextWrapping="Wrap" Text="Dr.CONNECTIFY 3" VerticalAlignment="Top" Foreground="Black" FontSize="48" FontWeight="Bold" FontFamily="JF Flat"/>
        <TextBlock Margin="26,9,0,0" TextWrapping="Wrap" Text="Dr.CONNECTIFY 3" VerticalAlignment="Top" FontSize="48" FontFamily="JF Flat" FontWeight="Bold" HorizontalAlignment="Left">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF5D81F" Offset="0"/>
                    <GradientStop Color="#FFAAAAAA" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
        <Rectangle x:Name="back" Height="30" VerticalAlignment="Bottom" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF037F01" Offset="0"/>
                    <GradientStop Color="#FF106A0E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock x:Name="text" Opacity="0" Margin="10,0,0,5" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Foreground="White" FontSize="14" HorizontalAlignment="Left"><Run Name="run"/></TextBlock>
        <Ellipse Fill="#7F43B0E2" HorizontalAlignment="Left" Height="100" Margin="297,294,0,0" Stroke="Black" VerticalAlignment="Top" Width="100"/>
    </Grid>
</Window>
