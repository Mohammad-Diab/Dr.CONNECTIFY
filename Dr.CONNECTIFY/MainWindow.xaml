<Window x:Class="My_Connectify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dr.CONNECTIFY" Height="320" Width="380" ResizeMode="CanMinimize" Icon="Images/icon_32.png" Loaded="Window_Loaded">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="LightSkyBlue" Offset="0"/>
            <GradientStop Color="White" Offset="0.3333333333"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Button x:Name="go" Height="40" Margin="96,160,96,0" VerticalAlignment="Top" FontSize="20" Click="Add_Click" Background="{x:Null}" Foreground="RoyalBlue">
            <Button.Content>
                <Grid Width="178" Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="177"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Image HorizontalAlignment="Left" Source="Images/windows_shell.png" Stretch="None" Grid.Column="1"/>
                        <TextBlock Text="Go ahead" Margin="50,4,0,0" Height="27" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Left" Width="85"/>
                    </Grid>
                </Grid>
            </Button.Content>
        </Button>
        <Button x:Name="stop" Height="40" Margin="96,205,96,0" VerticalAlignment="Top" FontSize="20" Click="Remove_Click" Background="{x:Null}" Foreground="Red">
            <Button.Content>
                <Grid Width="178" Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="177"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Image HorizontalAlignment="Left" Source="Images/windows_shell.png" Stretch="None" Grid.Column="1"/>
                        <TextBlock Text="Stop network" Margin="39,4,0,0" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </Button.Content>
        </Button>
        <PasswordBox x:Name="password" Margin="130,120,60,0" VerticalAlignment="Top" FontSize="19" Password="Dr.Mohammad" Background="{x:Null}" MaxLength="63" PasswordChar="&#xF053;" FontFamily="Wingdings"/>
        <TextBox x:Name="name" Margin="130,90,60,0" TextWrapping="Wrap" Text="Dr.Mohammad" VerticalAlignment="Top" FontSize="16" Background="{x:Null}" MaxLength="32" MaxLines="1" AutoWordSelection="True"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,119,0,0" TextWrapping="Wrap" Text="Password:" VerticalAlignment="Top" FontSize="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,91,0,0" TextWrapping="Wrap" Text="Network name:" VerticalAlignment="Top" FontSize="16"/>
        <Rectangle x:Name="back" Height="30" VerticalAlignment="Bottom" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF037F01" Offset="0"/>
                    <GradientStop Color="#FF106A0E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock x:Name="text" Opacity="0" Margin="10,0,0,5" TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="White" FontSize="14" HorizontalAlignment="Left"><Run Name="run"/></TextBlock>
        <Button ToolTip="about" HorizontalAlignment="Right" Height="32" Margin="0,47,10,0" VerticalAlignment="Top" Width="32" Background="{x:Null}" Click="Button_Click" BorderBrush="{x:Null}">
            <Button.Content>
                <Image Source="Images/about.png"/>
            </Button.Content>
        </Button>
        <Button ToolTip="Help" HorizontalAlignment="Right" Height="32" Margin="0,10,10,0" VerticalAlignment="Top" Width="32" Background="{x:Null}" Click="Button_Click" BorderBrush="{x:Null}">
            <Button.Content>
                <Image Source="Images/help.png"/>
            </Button.Content>
        </Button>
        <Button x:Name="show_password" ToolTip="Show password" HorizontalAlignment="Right" Margin="0,118,20,0" VerticalAlignment="Top" Background="{x:Null}" Click="ShowHide_Click">
            <Button.Content>
                <Image Source="Images/eye.png" Stretch="None"/>
            </Button.Content>
        </Button>
        <TextBox x:Name="password_shadow" Margin="130,120,60,0" VerticalAlignment="Top" FontSize="16" Text="Dr.Mohammad" Background="{x:Null}" Visibility="Collapsed" AutoWordSelection="True" MaxLines="1" MaxLength="63"/>
        <TextBlock HorizontalAlignment="Left" Margin="25,20,0,0" TextWrapping="Wrap" Text="Dr.CONNECTIFY" VerticalAlignment="Top" Foreground="Black" FontSize="36" FontFamily="Tempus Sans ITC" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="27,18,0,0" TextWrapping="Wrap" Text="Dr.CONNECTIFY" VerticalAlignment="Top" FontSize="36" FontFamily="Tempus Sans ITC" FontWeight="Bold">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="RoyalBlue" Offset="0"/>
                    <GradientStop Color="SkyBlue" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
        <Rectangle x:Name="color" HorizontalAlignment="Left" Margin="0,0,0,0" Width="0" Height="0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF037F01" Offset="0"/>
                    <GradientStop Color="#FF106A0E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Stroke>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterY="0.5" CenterX="0.5"/>
                            <RotateTransform Angle="-90" CenterY="0.5" CenterX="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FFB40100" Offset="1"/>
                    <GradientStop Color="#FFDC0201"/>
                </LinearGradientBrush>
            </Rectangle.Stroke>
        </Rectangle>
    </Grid>
</Window>
